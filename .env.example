# Copy to .env.local for local development and add the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real tokens.
#
# All variables are SERVER-ONLY. Do NOT prefix any of them with NEXT_PUBLIC_ –
# that would ship the value to every visitor's browser.

# Your store's permanent domain (no https://). Setting this turns Shopify on.
# Leave empty to run on the built-in demo products.
SHOPIFY_STORE_DOMAIN=nu0qsj-s1.myshopify.com

# Pinned Storefront API version. Shopify ships a new one every quarter and supports each for at
# least 12 months – bump this deliberately, e.g. once per quarter.
SHOPIFY_API_VERSION=2026-10

# Storefront API access. Optional: without a token the site uses Shopify's "tokenless access"
# (products + cart, but a lower query-complexity limit). For production use a token:
#
# Preferred – private Storefront token (server-side only, header Shopify-Storefront-Private-Token):
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Alternative – public Storefront token (header X-Shopify-Storefront-Access-Token):
SHOPIFY_STOREFRONT_TOKEN=
# NEVER put an Admin API token in either of these.

# Secret used to verify Shopify webhooks sent to /api/revalidate (refreshes product data on change).
SHOPIFY_WEBHOOK_SECRET=

# Order lookup on /track-order (server-only). The page shows "temporarily unavailable" until one of these is set.
# Option A (recommended, new stores): an app made in the Shopify Dev Dashboard with ONLY the read_orders scope,
# installed on this store. Its client id/secret are exchanged for a token that renews itself.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: a static Admin API token from an older custom app (read_orders only).
SHOPIFY_ADMIN_TOKEN=
