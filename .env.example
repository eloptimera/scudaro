# Copy to .env.local for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables).
#
# Leave SHOPIFY_STORE_DOMAIN / SHOPIFY_STOREFRONT_TOKEN empty to run on the built-in demo products.

# Your store's permanent domain, e.g. scudaro.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (public, read + cart). NEVER put an Admin API token here.
SHOPIFY_STOREFRONT_TOKEN=

# Storefront API version. Check Shopify's docs for currently supported versions.
SHOPIFY_API_VERSION=2026-04

# Secret used to verify webhooks (Shopify Admin → Settings → Notifications → Webhooks).
# Used by /api/revalidate to refresh product data when products change.
SHOPIFY_WEBHOOK_SECRET=
